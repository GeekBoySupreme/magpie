{
  "manifest_version": 3,
  "name": "Magpie: saves into plans",
  "short_name": "Magpie",
  "version": "1.0.0",
  "description": "Collect X bookmarks and Instagram saves, index their images and video with Gemini, and turn them into plans you can chat with.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Open Magpie",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.exa.ai/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+M" }, "description": "Open Magpie" }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.instagram.com/*"],
      "js": ["content/intercept.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/common.js", "content/twitter.js"],
      "css": ["content/inject.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content/common.js", "content/instagram.js"],
      "css": ["content/inject.css"],
      "run_at": "document_idle"
    }
  ]
}
